# SQLite development; relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"
ADMIN_PASSWORD="replace-with-a-long-unique-password"
SESSION_SECRET="replace-with-at-least-32-random-characters"
OTP_SECRET="replace-with-another-32-random-characters"
OTP_PROVIDER="mock"
# Mock is refused in production unless explicitly enabled for a private demo.
ALLOW_MOCK_OTP="false"
ISRAEL_SMS_API_URL=""
ISRAEL_SMS_API_KEY=""
REQUIRE_ADMIN_APPROVAL="false"
STORAGE_DIR="./storage"
KEYWORD_BLOCKLIST_FILE="./config/blocked-keywords.json"
SHABBAT_NOTICE=""
CONTACT_PHONE=""
# Set only behind a proxy that OVERWRITES X-Forwarded-For.
TRUST_PROXY="false"
POSTGRES_PASSWORD="replace-with-a-database-password"
